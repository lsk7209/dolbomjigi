[Unit]
Description=CI-gated Dolbomjigi deployment from GitHub main
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/dolbomjigi-production/autodeploy/runner.py
UMask=0077
CPUQuota=100%
CPUWeight=25
MemoryMax=3G
TasksMax=256
IOWeight=25
Nice=10
TimeoutStartSec=3600
TimeoutStopSec=180
KillMode=control-group
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
