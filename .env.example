# ─── Turso (libSQL) Database ──────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-token

# ─── Site URL ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://dolbomjigi.ehon365.kr

# ─── Public API Keys ─────────────────────────────────────────────────
BIZINFO_API_KEY=your-bizinfo-api-key
KOSIS_API_KEY=your-kosis-api-key

# ─── Notifications & Review ──────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
REVIEWER_EMAIL=reviewer@example.com

# ─── Cron & Administration Secrets ───────────────────────────────────
CRON_SECRET=your-cron-bearer-secret
ADMIN_SECRET=your-admin-secret-for-lint-api
INDEXNOW_KEY=your-indexnow-key

# ─── Analytics, AdSense & Verification ───────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-token
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=your-naver-verification-token
